{
  "name": "@regcheck/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/documents/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/documents/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@firecrawl/pdf-inspector": "^1.25.2",
    "cheerio": "^1.2.0",
    "fastify": "^5.6.2",
    "ipaddr.js": "^2.5.0",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@firecrawl/pdf-inspector-linux-arm64-musl": "^1.25.2",
    "@firecrawl/pdf-inspector-linux-x64-musl": "^1.25.2"
  }
}
